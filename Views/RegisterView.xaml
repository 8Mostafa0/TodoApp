<UserControl x:Class="TodoApp.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TodoApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Register Screen"/>
        <TextBox Grid.Row="1"  Grid.Column="1" Grid.ColumnSpan="4"  Margin="10" />
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Margin="10"/>
        <Button   Grid.Row="3"  Grid.Column="1" Grid.ColumnSpan="2" Content="Login" Margin="10"/>
        <Button   Grid.Row="3"  Grid.Column="3" Grid.ColumnSpan="2" Content="Register" Margin="10"/>
    </Grid>
</UserControl>
